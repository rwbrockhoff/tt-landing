---
import { Mail, ArrowRight } from 'lucide-astro';
---

<section class="cta-section">
	<div class="readable-width text-center">
		<h3 class="mb-2">Questions? Let's chat.</h3>
		<p class="text-lg mb-8 max-w-3xl mx-auto">Check out our features or get in touch.</p>
		<div class="flex gap-4 justify-center flex-col sm:flex-row">
			<a href="/" class="btn-sierra" role="button">
				<ArrowRight class="w-5 h-5 mr-2" />See Features
			</a>
			<a href="mailto:hello@tidytrek.co" class="btn-outline-sierra" role="button">
				<Mail class="w-5 h-5 mr-2" />Contact Us
			</a>
		</div>
	</div>
</section>

<style>
	.cta-section {
		margin-top: var(--space-8);
		padding: var(--space-12) var(--space-4);
		background-color: var(--color-bg-secondary);
		border-top: var(--border-primary);
	}
</style>

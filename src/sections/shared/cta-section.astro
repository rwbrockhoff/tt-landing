---
import Backpack from 'lucide-astro/Backpack';
import ChevronUp from 'lucide-astro/ChevronUp';
---

<section id="cta" class="py-16">
	<div class="readable-width text-center">
		<h3 class="mb-6">Ready to Pack Smarter?</h3>
		<p class="text-lg mb-8 max-w-3xl mx-auto">Join hikers planning backpacking gear lists for their next adventure.</p>
		<div class="flex gap-4 justify-center flex-col sm:flex-row">
			<a href="https://tidytrek.co/register" class="btn-sierra" role="button"
				><Backpack class="w-5 h-5 mr-2" />Sign Up</a
			>
			<a href="#top" class="btn-outline-sierra" role="button">
				<ChevronUp class="w-5 h-5 mr-2" />
				Back to Top
			</a>
		</div>
	</div>
</section>

<style>
	#cta {
		background-color: var(--color-bg-secondary);
		border-top: var(--border-primary);
	}
</style>

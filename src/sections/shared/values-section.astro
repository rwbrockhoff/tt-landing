---
import { Check } from 'lucide-astro';
---

<section class="values-section">
	<div class="readable-width">
		<h3 class="section-header">We're a small team building for our community.</h3>
		<p class="section-intro">Built by backpackers, for backpackers.</p>
		<ul class="values-list">
			<li><Check class="check-icon" /> Your data stays yours</li>
			<li><Check class="check-icon" /> Use your own affiliate links</li>
			<li><Check class="check-icon" /> Actively maintained & improved</li>
			<li><Check class="check-icon" /> Funded by the community</li>
		</ul>
	</div>
</section>

<style>
	.values-section {
		padding: var(--space-12) 0;
		margin-bottom: var(--space-8);
		text-align: center;
	}

	.values-section .section-header {
		margin-bottom: var(--space-2);
	}

	.values-section .section-intro {
		color: var(--color-text-secondary);
		font-size: 1.125rem;
		margin-bottom: var(--space-6);
	}

	.values-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.values-list li {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		font-size: 1.125rem;
		color: var(--color-text-primary);
	}

	.check-icon {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--sage-500);
	}
</style>

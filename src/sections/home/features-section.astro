---
import SavedPacksFeature from '../../components/features/saved-packs/saved-packs-feature.astro';
import FoodBagFeature from '../../components/features/food-bags/food-bag-feature.astro';
import ShakedownsFeature from '../../components/features/shakedowns/shakedowns-feature.astro';
import AnalyticsFeature from '../../components/features/analytics/analytics-feature.astro';
---

<div class="flex flex-col gap-8 py-8">
	<SavedPacksFeature
		title="Save & Discover Packs"
		subtitle="Save backpacking gear lists from other hikers and discover new setups."
		photoLeft={false}
	/>

	<FoodBagFeature
		title="Food Bags & Meal Planning"
		subtitle="Plan backpacking meals with calorie and weight tracking for weekend trips, resupply boxes, or aid stations."
		photoLeft={true}
	/>

	<ShakedownsFeature
		title="Create Gear Shakedowns"
		subtitle="Share your gear list, get pack feedback, and refine your setup all in one place."
		photoLeft={false}
	/>

	<AnalyticsFeature
		title="Track Your Pack Analytics"
		subtitle="Get insights into pack weight, gear popularity, and community engagement."
		photoLeft={true}
	/>
</div>

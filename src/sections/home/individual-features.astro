---
import IndividualFeature from '../../components/individual-feature.astro';
import SavedPacksFeature from '../../components/saved-packs-feature.astro';
import analyticsPreview from '../../assets/features/analytics-dashboard-preview.webp';
import shakedownPreview from '../../assets/features/shakedown-preview.webp';
import gearClosetPreview from '../../assets/features/gear-closet-preview.webp';
---

<section id="feature-screenshots">
	<SavedPacksFeature
		title="Save & Discover Packs"
		subtitle="Save your favorite gear setups from other hikers & backpackers and discover new gear."
		photoLeft={false}
		background="primary"
	/>

	<IndividualFeature
		title="Food Bags & Meal Planning"
		subtitle="Organize meals by day with calorie tracking and weight calculations."
		bullets={[
			'Track calories and nutrition for each day',
			'Calculate total food weight for your pack',
			'Monitor macros and performance nutrition',
		]}
		imageSrc={gearClosetPreview.src}
		imageAlt="TidyTrek food bags feature showing meal planning by day"
		photoLeft={true}
		background="secondary"
		borders={true}
	/>

	<IndividualFeature
		title="Create Shakedowns"
		subtitle="Share your gear and get feedback all in one place - no more jumping between apps."
		bullets={[
			'Keep pack history and feedback organized together',
			'Ask specific questions about gear and conditions',
			'Improve your setup before hitting the trail',
		]}
		imageSrc={shakedownPreview.src}
		imageAlt="TidyTrek shakedown feature showing community feedback on a pack"
		photoLeft={false}
		background="primary"
	/>

	<IndividualFeature
		title="Track Your Analytics"
		subtitle="Get detailed insights on your community engagement and pack performance."
		bullets={[
			'See which packs and gear get the most engagement',
			'Track performance for campaigns and sponsors',
			'See what resonates with your audience',
		]}
		imageSrc={analyticsPreview.src}
		imageAlt="TidyTrek analytics dashboard showing pack performance metrics"
		photoLeft={true}
		background="secondary"
	/>
</section>

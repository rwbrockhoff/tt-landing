---
import SavedPackCard from './saved-pack-card.astro';
import bookmarkCard1 from '../../../assets/features/bookmarks/bookmark-card-1.webp';
import bookmarkCard2 from '../../../assets/features/bookmarks/bookmark-card-2.webp';
import bookmarkCard3 from '../../../assets/features/bookmarks/bookmark-card-3.webp';
import bookmarkCard4 from '../../../assets/features/bookmarks/bookmark-card-4.webp';

import avatar1 from '../../../assets/avatars/avatar-1.webp';
import avatar2 from '../../../assets/avatars/avatar-2.webp';
import avatar3 from '../../../assets/avatars/avatar-3.webp';
import avatar4 from '../../../assets/avatars/avatar-4.webp';

interface PackCard {
	packImage: string;
	packName: string;
	packDescription: string;
	username: string;
	avatarImage?: string;
}

interface Props {
	title: string;
	subtitle: string;
	photoLeft?: boolean;
}

const { title, subtitle, photoLeft = false } = Astro.props;

const cards: PackCard[] = [
	{
		packImage: bookmarkCard1.src,
		packName: 'PCT Section J',
		packDescription: 'Ultralight setup for summer hiking through the Sierra Nevada',
		username: 'Rainy_Poppies9162',
		avatarImage: avatar1.src,
	},
	{
		packImage: bookmarkCard2.src,
		packName: 'Arizona Trail',
		packDescription: 'Desert hiking setup for hot, dry conditions with water carry capacity',
		username: 'Casual_Cliffs6989',
		avatarImage: avatar2.src,
	},
	{
		packImage: bookmarkCard3.src,
		packName: 'Western States 100',
		packDescription: 'Minimalist gear for 100-mile mountain race with crew access points',
		username: 'Lively_Marmot6551',
		avatarImage: avatar4.src,
	},
	{
		packImage: bookmarkCard4.src,
		packName: 'Kungsleden Winter',
		packDescription: 'Backcountry ski touring setup for multi-day winter expedition in Swedish Lapland',
		username: 'Pristine_Juniper5940',
		avatarImage: avatar3.src,
	},
];
---

<script src="../../../scripts/scroll-animations.js"></script>

<section class=`feature-showcase`>
	<div class="readable-width">
		<div class={`feature-grid ${photoLeft ? 'photo-left' : 'photo-right'}`}>
			<div class="feature-content">
				<h2 class="feature-title feature-title-large">{title}</h2>
				<p class="feature-subtitle">{subtitle}</p>
				<a href="https://tidytrek.co/register" class="btn-primary btn-md">Sign Up</a>
			</div>
			<div class="cards-container feature-image-wrapper">
				{
					cards.map((card, index) => (
						<div class={`card-wrapper card-${index + 1} animate-on-scroll`} data-animation-delay={index * 100}>
							<SavedPackCard
								packImage={card.packImage}
								packName={card.packName}
								packDescription={card.packDescription}
								username={card.username}
								avatarImage={card.avatarImage}
							/>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	@import '../styles/features.css';

	.feature-title-large {
		font-size: var(--font-size-12);
	}

	.cards-container {
		display: grid;
		grid-template-columns: 280px 280px;
		grid-template-rows: auto auto;
		row-gap: var(--space-6);
		column-gap: 0;
		align-items: center;
		justify-items: center;
		position: relative;
	}

	.card-wrapper {
		position: relative;
		overflow: hidden;
		border: none;
		box-shadow: none;
		width: 250px;
		flex-shrink: 0;
	}

	.card-wrapper.card-1 {
		--card-position-transform: translate(0, 0);
		grid-column: 1;
		grid-row: 1;
		transform: var(--card-position-transform);
		z-index: 2;
	}

	.card-wrapper.card-2 {
		--card-position-transform: translate(0, 0);
		grid-column: 2;
		grid-row: 1;
		transform: var(--card-position-transform);
		z-index: 1;
	}

	.card-wrapper.card-3 {
		--card-position-transform: translate(calc(var(--space-8) + var(--space-4)), 0);
		grid-column: 1;
		grid-row: 2;
		transform: var(--card-position-transform);
		z-index: 2;
	}

	.card-wrapper.card-4 {
		--card-position-transform: translate(calc(var(--space-8) + var(--space-4)), 0);
		grid-column: 2;
		grid-row: 2;
		transform: var(--card-position-transform);
		z-index: 1;
	}

	@media (max-width: 1023px) {
		.cards-container {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-4);
		}

		.card-wrapper {
			width: 100%;
			max-width: 400px;
		}

		.card-wrapper.card-1,
		.card-wrapper.card-2 {
			--card-position-transform: translate(0, 0);
			transform: var(--card-position-transform);
			grid-column: auto;
			grid-row: auto;
		}

		.card-wrapper.card-3,
		.card-wrapper.card-4 {
			display: none;
		}
	}
</style>

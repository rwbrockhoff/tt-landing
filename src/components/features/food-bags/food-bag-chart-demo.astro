---
import BarChart from './bar-chart.astro';

const arcticPalette = {
	blue: '#1971a6',
	lightBlue: '#66c3db',
	purple: '#98b6ff',
	mediumBlue: '#66a7e4',
	pink: '#c98ca7',
	lavender: '#899af1',
	cyan: '#5fa8d3',
	teal: '#34a0a4',
};

const chartData = [
	{ label: 'Day 1', percentage: 85, color: arcticPalette.blue, delay: 100 },
	{ label: 'Day 2', percentage: 92, color: arcticPalette.lightBlue, delay: 200 },
	{ label: 'Day 3', percentage: 78, color: arcticPalette.purple, delay: 300 },
	{ label: 'Day 4', percentage: 88, color: arcticPalette.mediumBlue, delay: 400 },
];

const dayStats = [
	{ label: 'Day 1', value: '3,500 cal', color: arcticPalette.blue },
	{ label: 'Day 2', value: '3,700 cal', color: arcticPalette.lightBlue },
	{ label: 'Day 3', value: '3,300 cal', color: arcticPalette.purple },
	{ label: 'Day 4', value: '3,500 cal', color: arcticPalette.mediumBlue },
];

const totalStats = [
	{ label: 'Total Calories', value: '14,000 cal' },
	{ label: 'Total Weight', value: '9.2 lbs' },
];
---

<script src="../../../scripts/scroll-animations.js"></script>

<div class="chart-demo-wrapper">
	<div class="summary-panel">
		<h3 class="summary-title">High Divide Loop</h3>

		<div class="day-stats-section">
			{
				dayStats.map((stat) => (
					<div class="stat-row">
						<div class="stat-label-with-circle">
							<span class="color-circle" style={`background-color: ${stat.color}`} />
							<span class="stat-label">{stat.label}</span>
						</div>
						<span class="stat-value">{stat.value}</span>
					</div>
				))
			}
		</div>

		<div class="total-stats-section">
			{
				totalStats.map((stat) => (
					<div class="stat-row">
						<span class="stat-label">{stat.label}</span>
						<span class="stat-value">{stat.value}</span>
					</div>
				))
			}
		</div>
	</div>

	<div class="chart-bars">
		{chartData.map((data, index) => <BarChart percentage={data.percentage} color={data.color} delay={index * 100} />)}
	</div>
</div>

<style>
	.chart-demo-wrapper {
		display: flex;
		flex-direction: row;
		gap: var(--space-6);
		padding: var(--space-6);
		background-color: var(--color-bg-secondary);
		border-radius: var(--radius-lg);
		border: var(--border-primary);
		box-shadow: var(--shadow-paper);
		align-items: center;
	}

	.summary-panel {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.summary-title {
		font-size: var(--font-size-7);
		font-weight: var(--font-weight-bold);
		margin: 0;
		color: var(--color-text-primary);
	}

	.day-stats-section {
		display: flex;
		flex-direction: column;
	}

	.day-stats-section .stat-row {
		padding: var(--space-2) 0;
		background: transparent;
	}

	.stat-label-with-circle {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.color-circle {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.total-stats-section {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-bg-tertiary);
	}

	.stat-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.stat-label {
		color: var(--color-text-primary);
	}

	.stat-value {
		color: var(--color-text-primary);
	}

	.stat-label {
		font-size: var(--font-size-2);
		font-weight: var(--font-weight-medium);
	}

	.stat-value {
		background: rgba(0, 0, 0, 0.08);
		font-size: var(--font-size-2);
		font-weight: var(--font-weight-medium);
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius);
	}

	:global([data-theme='dark']) .stat-value {
		background: rgba(255, 255, 255, 0.1);
	}

	.chart-bars {
		flex: 1;
		display: flex;
		flex-direction: row;
		gap: var(--space-4);
		align-items: flex-end;
		justify-content: center;
		align-self: flex-end;
	}

	@media (max-width: 768px) {
		.chart-demo-wrapper {
			flex-direction: column;
			padding: var(--space-4);
			align-items: stretch;
		}

		.summary-panel {
			width: 100%;
		}

		.chart-bars {
			width: 100%;
			align-self: center;
			justify-content: space-evenly;
			gap: var(--space-6);
		}
	}
</style>

---
import AnalyticsDemo from './analytics/analytics-demo.astro';

interface Props {
	title: string;
	subtitle: string;
	photoLeft?: boolean;
}

const { title, subtitle, photoLeft = false } = Astro.props;
---

<section class=`feature-showcase`>
	<div class="readable-width">
		<div class={`feature-grid ${photoLeft ? 'photo-left' : 'photo-right'}`}>
			<div class="feature-content">
				<h2 class="feature-title">{title}</h2>
				<p class="feature-subtitle">{subtitle}</p>
				<a href="https://tidytrek.co/register" class="btn-primary btn-md">Sign Up</a>
			</div>
			<div class="feature-demo-wrapper">
				<AnalyticsDemo />
			</div>
		</div>
	</div>
</section>

<style>
	.feature-showcase {
		padding-block: var(--space-8);
	}

	.feature-showcase.bg-primary {
		background-color: var(--color-bg-primary);
	}

	.feature-showcase.bg-secondary {
		background-color: var(--color-bg-secondary);
	}

	.feature-showcase.with-borders {
		border-top: var(--border-primary);
		border-bottom: var(--border-primary);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-8);
		align-items: center;
	}

	@media (min-width: 1024px) {
		.feature-grid {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-12);
		}

		.feature-grid.photo-left {
			grid-template-areas: 'image content';
		}

		.feature-grid.photo-left .feature-demo-wrapper {
			grid-area: image;
		}

		.feature-grid.photo-left .feature-content {
			grid-area: content;
		}

		.feature-grid.photo-right {
			grid-template-areas: 'content image';
		}

		.feature-grid.photo-right .feature-content {
			grid-area: content;
		}

		.feature-grid.photo-right .feature-demo-wrapper {
			grid-area: image;
		}
	}

	.feature-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.feature-title {
		font-size: var(--font-size-10);
		font-weight: var(--font-weight-bold);
		color: var(--color-text-primary);
		line-height: 1;
	}

	.feature-subtitle {
		font-size: var(--font-size-6);
		color: var(--color-text-primary);
		line-height: var(--line-height-normal);
		font-family: var(--font-mono);
	}

	.feature-demo-wrapper {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
	}

	@media (max-width: 1023px) {
		.feature-grid {
			text-align: left;
			padding: 0 var(--space-4);
			gap: var(--space-12);
		}
	}
</style>

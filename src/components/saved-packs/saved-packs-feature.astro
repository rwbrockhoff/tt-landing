---
import SavedPackCard from './saved-pack-card.astro';
import bookmarkCard1 from '../../assets/features/bookmarks/bookmark-card-1.webp';
import bookmarkCard2 from '../../assets/features/bookmarks/bookmark-card-2.webp';
import bookmarkCard3 from '../../assets/features/bookmarks/bookmark-card-3.webp';
import bookmarkCard4 from '../../assets/features/bookmarks/bookmark-card-4.webp';

import avatar1 from '../../assets/avatars/avatar-1.webp';
import avatar2 from '../../assets/avatars/avatar-2.webp';
import avatar3 from '../../assets/avatars/avatar-3.webp';
import avatar4 from '../../assets/avatars/avatar-4.webp';

interface PackCard {
	packImage: string;
	packName: string;
	packDescription: string;
	username: string;
	avatarImage?: string;
}

interface Props {
	title: string;
	subtitle: string;
	photoLeft?: boolean;
	background?: 'primary' | 'secondary';
	borders?: boolean;
}

const { title, subtitle, photoLeft = false, background = 'primary', borders = false } = Astro.props;

const cards: PackCard[] = [
	{
		packImage: bookmarkCard1.src,
		packName: 'PCT Section J',
		packDescription: 'Ultralight setup for summer hiking through the Sierra Nevada',
		username: 'Rainy_Poppies9162',
		avatarImage: avatar1.src,
	},
	{
		packImage: bookmarkCard2.src,
		packName: 'Arizona Trail',
		packDescription: 'Desert hiking setup for hot, dry conditions with water carry capacity',
		username: 'Casual_Cliffs6989',
		avatarImage: avatar2.src,
	},
	{
		packImage: bookmarkCard3.src,
		packName: 'Western States 100',
		packDescription: 'Minimalist gear for 100-mile mountain race with crew access points',
		username: 'Lively_Marmot6551',
		avatarImage: avatar4.src,
	},
	{
		packImage: bookmarkCard4.src,
		packName: 'Kungsleden Winter',
		packDescription: 'Backcountry ski touring setup for multi-day winter expedition in Swedish Lapland',
		username: 'Pristine_Juniper5940',
		avatarImage: avatar3.src,
	},
];
---

<script src="../../scripts/scroll-animations.js"></script>

<section class={`feature-showcase py-12 bg-${background} ${borders ? 'with-borders' : ''}`}>
	<div class="readable-width">
		<div class={`feature-grid ${photoLeft ? 'photo-left' : 'photo-right'}`}>
			<div class="feature-content">
				<h2 class="feature-title">{title}</h2>
				<p class="feature-subtitle">{subtitle}</p>
				<a href="https://tidytrek.co/register" class="btn-primary btn-md">Sign Up</a>
			</div>
			<div class="cards-container">
				{
					cards.map((card, index) => (
						<div class={`card-wrapper card-${index + 1} animate-on-scroll`} data-animation-delay={index * 100}>
							<SavedPackCard
								packImage={card.packImage}
								packName={card.packName}
								packDescription={card.packDescription}
								username={card.username}
								avatarImage={card.avatarImage}
							/>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.feature-showcase.bg-primary {
		background-color: var(--color-bg-primary);
	}

	.feature-showcase.bg-secondary {
		background-color: var(--color-bg-secondary);
	}

	.feature-showcase .feature-title {
		color: var(--color-text-primary);
	}

	.feature-showcase.with-borders {
		border-top: var(--border-primary);
		border-bottom: var(--border-primary);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-8);
		align-items: center;
	}

	@media (min-width: 1024px) {
		.feature-grid {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-12);
		}

		.feature-grid.photo-left {
			grid-template-areas: 'image content';
		}

		.feature-grid.photo-left .cards-container {
			grid-area: image;
		}

		.feature-grid.photo-left .feature-content {
			grid-area: content;
		}

		.feature-grid.photo-right {
			grid-template-areas: 'content image';
		}

		.feature-grid.photo-right .feature-content {
			grid-area: content;
		}

		.feature-grid.photo-right .cards-container {
			grid-area: image;
		}
	}

	.feature-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.feature-title {
		font-size: var(--font-size-12);
		font-weight: var(--font-weight-bold);
		color: var(--color-text-primary);
		line-height: 1;
	}

	.feature-subtitle {
		font-size: var(--font-size-6);
		color: var(--color-text-primary);
		line-height: var(--line-height-normal);
		font-family: var(--font-mono);
	}

	.feature-bullets {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.feature-bullet {
		font-size: var(--font-size-5);
		color: var(--color-text-primary);
		line-height: var(--line-height-normal);
		position: relative;
		padding-left: var(--space-6);
	}

	.feature-bullet::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--sage-500);
		font-weight: var(--font-weight-bold);
	}

	.cards-container {
		display: grid;
		grid-template-columns: 280px 280px;
		grid-template-rows: auto auto;
		row-gap: var(--space-6);
		column-gap: 0;
		align-items: center;
		justify-items: center;
		position: relative;
	}

	.card-wrapper {
		position: relative;
		overflow: hidden;
		border: none;
		box-shadow: none;
		width: 250px;
		flex-shrink: 0;
	}

	.card-wrapper.card-1 {
		--card-position-transform: translate(0, 0);
		grid-column: 1;
		grid-row: 1;
		transform: var(--card-position-transform);
		z-index: 2;
	}

	.card-wrapper.card-2 {
		--card-position-transform: translate(0, 0);
		grid-column: 2;
		grid-row: 1;
		transform: var(--card-position-transform);
		z-index: 1;
	}

	.card-wrapper.card-3 {
		--card-position-transform: translate(calc(var(--space-8) + var(--space-4)), 0);
		grid-column: 1;
		grid-row: 2;
		transform: var(--card-position-transform);
		z-index: 2;
	}

	.card-wrapper.card-4 {
		--card-position-transform: translate(calc(var(--space-8) + var(--space-4)), 0);
		grid-column: 2;
		grid-row: 2;
		transform: var(--card-position-transform);
		z-index: 1;
	}

	.feature-image {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 1.5rem;
	}

	@media (max-width: 1023px) {
		.feature-showcase {
			padding-block: var(--space-12);
		}

		.feature-grid {
			text-align: left;
			padding: 0 var(--space-4);
			gap: var(--space-12);
		}

		.feature-bullets {
			text-align: left;
		}

		.cards-container {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-4);
		}

		.card-wrapper {
			width: 100%;
			max-width: 400px;
		}

		.card-wrapper.card-1,
		.card-wrapper.card-2 {
			--card-position-transform: translate(0, 0);
			transform: var(--card-position-transform);
			grid-column: auto;
			grid-row: auto;
		}

		.card-wrapper.card-3,
		.card-wrapper.card-4 {
			display: none;
		}
	}
</style>

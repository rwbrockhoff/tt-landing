---
interface Props {
	title: string;
	subtitle: string;
	bullets: string[];
	imageSrc: string;
	imageAlt: string;
	photoLeft?: boolean;
	background?: 'primary' | 'secondary';
	borders?: boolean;
}

const { title, subtitle, bullets, imageSrc, imageAlt, photoLeft = false, background = 'primary', borders = false } = Astro.props;
---

<section class={`feature-showcase py-16 bg-${background} ${borders ? 'with-borders' : ''}`}>
	<div class="readable-width">
		<div class={`feature-grid ${photoLeft ? 'photo-left' : 'photo-right'}`}>
			<div class="feature-content">
				<h2 class="feature-title">{title}</h2>
				<p class="feature-subtitle">{subtitle}</p>
				<ul class="feature-bullets">
					{bullets.map(bullet => (
						<li class="feature-bullet">{bullet}</li>
					))}
				</ul>
			</div>
			<div class="feature-image-wrapper">
				<img
					src={imageSrc}
					alt={imageAlt}
					class="feature-image"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.feature-showcase.bg-primary {
		background-color: var(--color-bg-primary);
	}

	.feature-showcase.bg-secondary {
		background-color: var(--color-bg-secondary);
	}

	.feature-showcase.with-borders {
		border-top: var(--border-primary);
		border-bottom: var(--border-primary);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-8);
		align-items: center;
	}

	@media (min-width: 1024px) {
		.feature-grid {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-12);
		}

		.feature-grid.photo-left {
			grid-template-areas: "image content";
		}

		.feature-grid.photo-left .feature-image-wrapper {
			grid-area: image;
		}

		.feature-grid.photo-left .feature-content {
			grid-area: content;
		}

		.feature-grid.photo-right {
			grid-template-areas: "content image";
		}

		.feature-grid.photo-right .feature-content {
			grid-area: content;
		}

		.feature-grid.photo-right .feature-image-wrapper {
			grid-area: image;
		}
	}

	.feature-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.feature-title {
		font-size: var(--font-size-8);
		font-weight: var(--font-weight-bold);
		color: var(--color-text-primary);
		line-height: var(--line-height-tight);
	}

	.feature-subtitle {
		font-size: var(--font-size-5);
		color: var(--color-text-primary);
		line-height: var(--line-height-normal);
		font-family: var(--font-mono);
	}

	.feature-bullets {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.feature-bullet {
		font-size: var(--font-size-4);
		color: var(--color-text-primary);
		line-height: var(--line-height-normal);
		position: relative;
		padding-left: var(--space-6);
	}

	.feature-bullet::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--sage-500);
		font-weight: var(--font-weight-bold);
	}

	.feature-image-wrapper {
		position: relative;
		border-radius: 1.5rem;
		overflow: hidden;
		box-shadow: var(--shadow-paper);
		border: var(--border-primary);
	}

	.feature-image {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 1.5rem;
	}

	@media (max-width: 1023px) {
		.feature-grid {
			text-align: left;
			padding: 0 var(--space-4);
		}

		.feature-bullets {
			text-align: left;
		}
	}
</style>
---
import MainLayout from '../layouts/main-layout.astro';
import AboutSection from '../components/about/about-section.astro';
---

<MainLayout title="About">
	<div class="about-page">
		<section class="hero-section">
			<div class="readable-width text-center">
				<h1>Lighterpack needed a refresh. So we built one.</h1>
				<p class="subline">And then we added the features we wish it had.</p>
			</div>
		</section>
		<AboutSection />
	</div>
</MainLayout>

<style>
	.about-page {
		min-height: 100%;
		padding-top: calc(var(--navbar-height) + var(--space-8));
		padding-bottom: var(--space-12);
		background-color: var(--color-bg-primary);
	}

	.hero-section {
		padding: 4rem 0;
	}

	.hero-section h1 {
		color: var(--color-text-primary);
		margin-bottom: var(--space-4);
	}

	.hero-section .subline {
		color: var(--color-text-secondary);
		font-size: var(--text-lg);
	}
</style>

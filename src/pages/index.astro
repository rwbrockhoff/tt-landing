---
import MainLayout from '../layouts/main-layout.astro';
import HeroSection from '../sections/home/hero.astro';
import FeaturesSection from '../sections/home/features-section.astro';
import PricingSection from '../sections/home/pricing.astro';
import CtaSection from '../sections/shared/cta-section.astro';
---

<MainLayout
	title="Backpacking Gear Lists & Pack Planning"
	description="Create backpacking gear lists, track weight, plan meals, and organize your pack for any adventure — from ultralight trips to thru-hikes.">
	<HeroSection />
	<section class="use-case-bar">
		<p>Built for backpacking, ultralight setups, thru-hikes, trail running & ultrarunning, day hikes & more</p>
	</section>
	<FeaturesSection />
	<PricingSection />
	<CtaSection />
</MainLayout>

<style>
	.use-case-bar {
		background-color: var(--sage-700);
		padding: 1rem var(--space-4);
		text-align: center;
		border-bottom: 2px solid var(--sage-900);
	}

	.use-case-bar p {
		color: #ffffff;
		font-size: var(--font-size-3);
		margin: 0;
		font-weight: var(--font-weight-medium);
		font-family: var(--font-mono);
	}
</style>

---
import MainLayout from '../layouts/main-layout.astro';
import PrivacyContent from '../components/legal/privacy-policy-content.astro';
---

<MainLayout
	title="Privacy Policy"
	description="Tidytrek privacy policy. Learn how we collect, use, and protect your data.">
	<div class="privacy-page">
		<div class="readable-width">
			<PrivacyContent />
		</div>
	</div>
</MainLayout>

<style>
	.privacy-page {
		min-height: 100%;
		padding-top: calc(var(--navbar-height) + var(--space-8));
		padding-bottom: var(--space-12);
		background-color: var(--color-bg-primary);
	}

	.readable-width {
		max-width: 800px;
	}
</style>
